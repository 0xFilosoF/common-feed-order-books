# All variables are optional: config.yaml contains a complete local configuration.
# No exchange API keys, account, private keys, or other secrets are required.
# Precedence: process environment > .env.local > .env > YAML.
BOOKS_CONFIG=config.yaml

# Use the address of the Redis instance you start or obtain from your administrator.
# Local cargo runs: 127.0.0.1:6379; Compose sets redis:6379 inside its network.
BOOKS__APP__REDIS__URL=redis://127.0.0.1:6379/0
BOOKS__APP__REDIS__KEY=order-books:ETHUSDT:snapshot
BOOKS__APP__REDIS__SNAPSHOT_INTERVAL_MS=250
BOOKS__APP__REDIS__TTL_MS=5000
BOOKS__APP__REDIS__IO_TIMEOUT_MS=1000

BOOKS__APP__IO__THREADS=2
BOOKS__APP__FEED__CHANNEL_CAPACITY=32
BOOKS__APP__FEED__CHANNEL_TIMEOUT_MS=10
BOOKS__APP__FEED__CONNECT_TIMEOUT_MS=10000
BOOKS__APP__FEED__IDLE_TIMEOUT_MS=3000
BOOKS__APP__FEED__RECONNECT_INITIAL_MS=250
BOOKS__APP__FEED__RECONNECT_MAX_MS=30000
BOOKS__APP__FEED__MAX_BAD_FRAMES=3
BOOKS__APP__SIGNAL__THRESHOLD_BPS=2
BOOKS__APP__SIGNAL__REPORT_INTERVAL_MS=1000
BOOKS__LOGS__LEVEL=info
BOOKS__LOGS__JSON=false
